+// Dispatch finite batches so event producers cannot monopolize the GUI thread.
+// Extra/stale native wake messages are harmless. AboutToWait must follow the
+// batch, since applications use it to flush their own accumulated events.
+fn dispatch_queued_user_events<T: 'static, F>(
+    event: Event<UserEventPlaceholder>,
+    receiver: &Receiver<T>,
+    pending: &AtomicUsize,
+    target: &RootAEL,
+    handler: &mut F,
+) where
+    F: FnMut(Event<T>, &RootAEL),
+{
+    let drain = |handler: &mut F| {
+        for _ in 0..256 {
+            if target.exiting() {
+                break;
+            }
+            let Ok(event) = receiver.try_recv() else { break; };
+            pending.fetch_sub(1, Ordering::AcqRel);
+            handler(Event::UserEvent(event), target);
+        }
+    };
+    match event.map_nonuser_event() {
+        Err(_) => drain(handler),
+        Ok(Event::AboutToWait) => {
+            drain(handler);
+            handler(Event::AboutToWait, target);
+        },
+        // Initial Resumed must precede user events queued before run_app.
+        Ok(event @ Event::NewEvents(crate::event::StartCause::Init)) => handler(event, target),
+        Ok(event @ Event::NewEvents(_)) => {
+            handler(event, target);
+            drain(handler);
+        },
+        Ok(event) => handler(event, target),
     }
 }
 
